#!/bin/bash
# lidwise — bounded, recoverable closed-lid awake sessions.
set -u

PMSET=${VIBECAF_PMSET:-/usr/bin/pmset}; CAFFEINATE=${VIBECAF_CAFFEINATE:-/usr/bin/caffeinate}
NETWORKSETUP=${VIBECAF_NETWORKSETUP:-/usr/sbin/networksetup}; IPCONFIG=${VIBECAF_IPCONFIG:-/usr/sbin/ipconfig}
ROUTE=${VIBECAF_ROUTE:-/sbin/route}; CURL=${VIBECAF_CURL:-/usr/bin/curl}
OSASCRIPT=${VIBECAF_OSASCRIPT:-/usr/bin/osascript}; SUDO=${VIBECAF_SUDO:-/usr/bin/sudo}
LAUNCHCTL=${VIBECAF_LAUNCHCTL:-/bin/launchctl}; PS=${VIBECAF_PS:-/bin/ps}; LOCKF=${VIBECAF_LOCKF:-/usr/bin/lockf}
SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0"); SELF_DIR=$(dirname "$SELF")
if [ -n "${VIBECAF_THERMAL_STATE_CMD:-}" ]; then THERMAL_STATE_CMD=$VIBECAF_THERMAL_STATE_CMD
elif [ -x "$SELF_DIR/../Helpers/lidwise-thermal" ]; then THERMAL_STATE_CMD="$SELF_DIR/../Helpers/lidwise-thermal"
elif [ -x "$SELF_DIR/../.build/helpers/lidwise-thermal" ]; then THERMAL_STATE_CMD="$SELF_DIR/../.build/helpers/lidwise-thermal"
else THERMAL_STATE_CMD="$SELF_DIR/lidwise-thermal"; fi
AGENT_SCAN_CMD=${VIBECAF_AGENT_SCAN_CMD:-"$SELF_DIR/lidwise-agent-scan"}
if [ -n "${VIBECAF_LID_PROBE_CMD:-}" ]; then LID_PROBE_CMD=$VIBECAF_LID_PROBE_CMD
elif [ -x "$SELF_DIR/../Helpers/lidwise-lid-probe" ]; then LID_PROBE_CMD="$SELF_DIR/../Helpers/lidwise-lid-probe"
elif [ -x "$SELF_DIR/../.build/helpers/lidwise-lid-probe" ]; then LID_PROBE_CMD="$SELF_DIR/../.build/helpers/lidwise-lid-probe"
else LID_PROBE_CMD="$SELF_DIR/lidwise-lid-probe"; fi
if [ -n "${VIBECAF_OBSERVATION_RUNNER:-}" ]; then OBSERVATION_RUNNER=$VIBECAF_OBSERVATION_RUNNER
elif [ -x "$SELF_DIR/../Helpers/lidwise-agent-scan-core" ]; then OBSERVATION_RUNNER="$SELF_DIR/../Helpers/lidwise-agent-scan-core"
else OBSERVATION_RUNNER="$SELF_DIR/../.build/helpers/lidwise-agent-scan-core"; fi

USER_ID=$(id -u)
RUNTIME_DIR=${VIBECAF_RUNTIME_DIR:-"/tmp/vibecaf.$USER_ID"}
STATE_DIR=${VIBECAF_STATE_DIR:-"$HOME/Library/Application Support/Closed-Lid Awake"}
SESSION_DIR="$STATE_DIR/session"; CONFIG_DIR="$STATE_DIR/config"; GOALS_DIR="$STATE_DIR/goals"; AGENTS_DIR="$STATE_DIR/agents"
LOG_DIR="$STATE_DIR/logs"; LOCK_DIR="$RUNTIME_DIR/session.lock"; NETLOG=${VIBECAF_NETLOG:-"$LOG_DIR/network.log"}
CAF_FLAGS=(-i -m -s)
DEFAULT_DURATION=${VIBECAF_DEADMAN_SECONDS:-21600}; DEFAULT_BATTERY_FLOOR=${VIBECAF_BATTERY_FLOOR:-20}
GUARD_EVERY=${VIBECAF_GUARD_EVERY:-60}; THERMAL_STRIKES=${VIBECAF_THERMAL_STRIKES:-3}
GUARDIAN_EVERY=${VIBECAF_GUARDIAN_EVERY:-30}; GUARDIAN_GRACE=${VIBECAF_GUARDIAN_GRACE:-180}
ACTIVATION_GRACE=${VIBECAF_ACTIVATION_GRACE:-30}
AGENT_CACHE_MAX_AGE=${VIBECAF_AGENT_CACHE_MAX_AGE:-120}
OBSERVATION_EVERY=${VIBECAF_OBSERVATION_EVERY:-60}; OBSERVATION_MAX_TICKS=${VIBECAF_OBSERVATION_MAX_TICKS:-0}
CHECK_EVERY=${VIBECAF_CHECK_EVERY:-20}; FAILS_BEFORE_CYCLE=${VIBECAF_FAILS_BEFORE_CYCLE:-2}
BACKOFF_MAX=${VIBECAF_BACKOFF_MAX:-180}; ASSOC_TIMEOUT=${VIBECAF_ASSOC_TIMEOUT:-60}
MAX_BOUNCES=${VIBECAF_MAX_BOUNCES:-3}; PASSIVE_EVERY=${VIBECAF_PASSIVE_EVERY:-60}; PASSIVE_RETRY=${VIBECAF_PASSIVE_RETRY:-900}
PROBE_URL=${VIBECAF_PROBE_URL:-http://captive.apple.com/hotspot-detect.html}
PORTAL_GRACE=${VIBECAF_PORTAL_GRACE:-300}; DEADLINK_GRACE=${VIBECAF_DEADLINK_GRACE:-120}
HOTSPOT_SUBNET=${VIBECAF_HOTSPOT_SUBNET:-172.20.10.}

LIB_DIR="$SELF_DIR/lib/lidwise"; [ -d "$LIB_DIR" ] || LIB_DIR="$SELF_DIR/../lib/lidwise"
source "$LIB_DIR/session.sh"
source "$LIB_DIR/history.sh"
if valid_duration "$ACTIVATION_GRACE"; then ACTIVATION_GRACE=$(uint_normalize "$ACTIVATION_GRACE"); else ACTIVATION_GRACE=30; fi
PIDFILE=$(runtime_file caffeinate.pid); NETPIDFILE=$(runtime_file network.pid)
GUARDPIDFILE=$(runtime_file guard.pid); NETSTATEFILE=$(runtime_file network.state)
OBSPIDFILE=$(runtime_file observation.pid)
AGENT_RUNTIME_DIR=$(runtime_file agent-state); AGENTSTATEFILE="$AGENT_RUNTIME_DIR/sessions.tsv"
THERMAL_STRIKE_FILE="$SESSION_DIR/thermal-strikes"; STARTFILE="$SESSION_DIR/started_at"
BATTERY_FLOOR=$(config_battery_floor); REQUIRE_AC=$(config_require_ac)
DEADMAN_SECONDS=$(config_duration); AGENT_NOTIFY=$(config_notifications)
NETWORK_RECOVERY=$([ "$(config_recovery)" = 1 ] && echo on || echo off)

sleep_disabled_state() {
  local output value
  output=$("$PMSET" -g 2>/dev/null) || { echo unknown; return; }
  value=$(printf '%s\n' "$output" | awk '$1 == "SleepDisabled" {print $2; exit}')
  case "$value" in 0|1) echo "$value" ;; *) echo unknown ;; esac
}
clamshell_blocked() { [ "$(sleep_disabled_state)" = 1 ]; }
batt_blob() { "$PMSET" -g batt 2>/dev/null; }
power_source() { case "$1" in *"AC Power"*) echo AC ;; *"Battery Power"*) echo Battery ;; *) echo unknown ;; esac; }
battery_pct() { printf '%s' "$1" | grep -o '[0-9][0-9]*%' | head -1; }
battery_num() { battery_pct "$1" | tr -d '%'; }
thermal_state() {
  local value
  [ -x "$THERMAL_STATE_CMD" ] || { echo unknown; return; }
  value=$("$THERMAL_STATE_CMD" 2>/dev/null) || value=unknown
  case "$value" in nominal|fair|serious|critical) echo "$value" ;; *) echo unknown ;; esac
}
wifi_device() { "$NETWORKSETUP" -listallhardwareports 2>/dev/null | awk '/Hardware Port: Wi-Fi/{getline; print $2; exit}'; }
wifi_service() { "$NETWORKSETUP" -listnetworkserviceorder 2>/dev/null | awk -v dev="$1" '
  /^\([0-9*]+\)/ {name=substr($0,index($0,")")+2)} index($0,"Device: " dev ")") {print name; exit}'; }
notify_event() {
  local title=$1 body=$2
  if [ -n "${VIBECAF_NOTIFY_LOG:-}" ]; then printf '%s\t%s\n' "$title" "$body" >> "$VIBECAF_NOTIFY_LOG"; return; fi
  ( exec 9>&- 2>/dev/null || true
    "$OSASCRIPT" -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
      -e 'end run' -- "$title" "$body" >/dev/null 2>&1 || true ) &
  if [ -n "${VIBECAF_NTFY_URL:-}" ]; then
    ( exec 9>&- 2>/dev/null || true
      exec "$CURL" -fsS --max-time 5 -H "Title: $title" --data-binary "$body" \
        "$VIBECAF_NTFY_URL" >/dev/null 2>&1 ) &
  fi
  return 0
}
admin_pmset() {
  "$SUDO" -n "$PMSET" -a disablesleep "$1" >/dev/null 2>&1 && return
  [ "${VIBECAF_NONINTERACTIVE:-0}" = 1 ] && return 1
  "$OSASCRIPT" -e "do shell script \"/usr/bin/pmset -a disablesleep $1\" with administrator privileges" >/dev/null 2>&1
}
preflight_restore() { "$SUDO" -n -k "$PMSET" -a disablesleep 0 >/dev/null 2>&1 && [ "$(sleep_disabled_state)" = 0 ]; }
recovery_authorization_current() {
  local output
  output=$("$SUDO" -n -k -ll -- "$PMSET" -a disablesleep 0 2>/dev/null) || return 1
  case "$output" in *'!authenticate'*|*'NOPASSWD:'*) return 0 ;; *) return 1 ;; esac
}
recovery_mark_failed() {
  local expected=${1:-} current
  current=$(current_session_id)
  [ -n "$expected" ] && [ "$current" = "$expected" ] || return 0
  rm -f "$SESSION_DIR/recovery_verified_at"
  rm -f "$SESSION_DIR/recovery_verified_session"
  write_field "$SESSION_DIR" recovery_failed_session "$expected" || true
  write_field "$SESSION_DIR" recovery_failed_at "$(date +%s)" || true
}
guardian_status() {
  local system_label="system/app.closedlidawake.guardian.$USER_ID" legacy="gui/$USER_ID/app.closedlidawake.guardian"
  if "$LAUNCHCTL" print "$system_label" >/dev/null 2>&1 || "$LAUNCHCTL" print "$legacy" >/dev/null 2>&1; then echo running
  elif [ -f "/Library/LaunchDaemons/app.closedlidawake.guardian.$USER_ID.plist" ] ||
       [ -f "$HOME/Library/LaunchAgents/app.closedlidawake.guardian.plist" ]; then echo installed
  else echo missing; fi
}
session_phase() {
  case "$(sleep_disabled_state)" in unknown) echo unknown ;; 0) echo off ;;
    1) if session_owned; then echo owned-on
       elif ownership_residue_unknown; then echo unknown
       else echo external-on; fi ;; esac
}

source "$LIB_DIR/observation.sh"; source "$LIB_DIR/network.sh"
type refresh_agents >/dev/null 2>&1 || refresh_agents() { agents_refresh "$@"; }
type refresh_goals >/dev/null 2>&1 || refresh_goals() { goals_refresh "$@"; }
type start_network_monitor >/dev/null 2>&1 || start_network_monitor() { start_netwatch "$@"; }
type stop_network_monitor >/dev/null 2>&1 || stop_network_monitor() { stop_netwatch "$@"; }
type network_status_token >/dev/null 2>&1 || network_status_token() { echo unknown; }
type agents_json >/dev/null 2>&1 || agents_json() { printf '%s' '{"claude":{"working":0,"waiting":0,"quiet":0,"finished":0,"failed":0},"codex":{"working":0,"waiting":0,"quiet":0,"finished":0,"failed":0}}'; }
type goals_json >/dev/null 2>&1 || goals_json() { printf '%s' '{"active":0,"stalled":0,"completed":0,"failed":0}'; }

start_owned_process() {
  local role=$1 file=$2 id pid; shift 2; id=$(current_session_id)
  ( exec 9>&- 2>/dev/null || true; exec "$@" >/dev/null 2>&1 ) & pid=$!
  process_record_write "$file" "$pid" "$role" "$id" || { kill "$pid" 2>/dev/null || true; return 1; }
}
start_guard() { local id; id=$(current_session_id); guard_pid "$id" >/dev/null && return; start_owned_process guard "$GUARDPIDFILE" "$SELF" __guard; }
stop_guard() { process_record_signal "$GUARDPIDFILE" guard "${1:-$(current_session_id)}"; }
start_caffeinate() { local id; id=$(current_session_id); our_caffeinate_pid "$id" >/dev/null && return; start_owned_process caffeinate "$PIDFILE" "$CAFFEINATE" "${CAF_FLAGS[@]}"; }
stop_caffeinate() { process_record_signal "$PIDFILE" caffeinate "${1:-$(current_session_id)}"; }
observation_pid() { process_record_matches "$OBSPIDFILE" observation "${1:-$(current_session_id)}"; }
start_observation() {
  local id
  if [ "${VIBECAF_NO_OBSERVATION:-0}" = 1 ]; then
    [ "${VIBECAF_NO_NETWATCH:-0}" != 1 ] && [ "$(config_recovery)" = 1 ] || return 0
  fi
  id=$(current_session_id); observation_pid "$id" >/dev/null && return 0
  start_owned_process observation "$OBSPIDFILE" "$SELF" __observation
}
stop_observation() { process_record_signal "$OBSPIDFILE" observation "${1:-$(current_session_id)}"; }
retire_session_processes() {
  local id=$1 rc=0 current_guard
  process_record_signal "$NETPIDFILE" netwatch "$id" || rc=1
  stop_observation "$id" || rc=1
  stop_caffeinate "$id" || rc=1
  current_guard=$(guard_pid "$id" 2>/dev/null || true)
  if [ "$current_guard" = "$$" ]; then rm -f "$GUARDPIDFILE"
  else stop_guard "$id" || rc=1; fi
  [ "$rc" -ne 0 ] || rm -f "$NETSTATEFILE"
  return "$rc"
}
retire_residue_processes() {
  local rc=0
  process_record_signal "$NETPIDFILE" netwatch "" || rc=1
  process_record_signal "$OBSPIDFILE" observation "" || rc=1
  process_record_signal "$PIDFILE" caffeinate "" || rc=1
  process_record_signal "$GUARDPIDFILE" guard "" || rc=1
  [ "$rc" -ne 0 ] || rm -f "$NETSTATEFILE"
  return "$rc"
}

guard_check_once_locked() {
  local blob src pct now deadline remaining thermal strikes floor require_ac warned
  [ "$(sleep_disabled_state)" = 1 ] && session_active || return 0
  if modern_session_owned && ! session_valid; then guard_auto_off "owned session policy is invalid"; return; fi
  session_touch || true; now=$(date +%s); deadline=$(read_uint "$SESSION_DIR" deadline 0)
  if [ "$deadline" -eq 0 ] || [ "$now" -ge "$deadline" ]; then guard_auto_off "session deadline passed"; return; fi
  remaining=$((deadline - now)); warned=$(read_uint "$SESSION_DIR" warned_deadline 0)
  if [ "$remaining" -le 300 ] && [ "$warned" -ne "$deadline" ]; then
    if write_field "$SESSION_DIR" warned_deadline "$deadline"; then
      notify_event "Awake session ending soon" "Session ends in 5 minutes or less. Use 'lidwise extend --by SECONDS' to extend it."
    fi
  fi
  thermal=$(thermal_state); strikes=$(read_uint "$SESSION_DIR" thermal-strikes 0)
  case "$thermal" in critical) guard_auto_off "thermal pressure: critical"; return ;;
    serious) strikes=$((strikes+1)); write_field "$SESSION_DIR" thermal-strikes "$strikes" || true
      [ "$strikes" -lt "$THERMAL_STRIKES" ] || { guard_auto_off "thermal pressure: serious for $strikes checks"; return; } ;;
    *) write_field "$SESSION_DIR" thermal-strikes 0 || true ;; esac
  blob=$(batt_blob || true); src=$(power_source "$blob"); pct=$(battery_num "$blob")
  floor=$(read_uint "$SESSION_DIR" battery_floor "$BATTERY_FLOOR")
  require_ac=$(read_uint "$SESSION_DIR" require_ac 0)
  if [ "$require_ac" = 1 ] && [ "$src" != AC ]; then guard_auto_off "AC power is required for this session"; return; fi
  if [ "$src" = Battery ] && valid_battery_percent "$pct" && [ "$pct" -le "$floor" ]; then guard_auto_off "battery floor: ${pct}% on battery"; fi
}
guard_check_once() {
  local rc id
  if ! lock_acquire; then
    id=$(current_session_id); [ -z "$id" ] || recovery_mark_failed "$id"
    return 1
  fi
  VIBECAF_GUARD_LOCK_HELD=1 guard_check_once_locked; rc=$?
  lock_release
  return "$rc"
}
guard_loop() {
  local id; id=$(current_session_id)
  while :; do case "$(sleep_disabled_state)" in 0) break ;; 1) guard_check_once || true ;;
    unknown) netlog "guard: could not read SleepDisabled; recovery remains armed" ;; esac; sleep "$GUARD_EVERY"; done
  [ "$$" = "$(guard_pid "$id" 2>/dev/null || true)" ] && rm -f "$GUARDPIDFILE"
}
guard_auto_off() {
  local reason=$1 id; id=$(current_session_id)
  if [ "${VIBECAF_GUARD_LOCK_HELD:-0}" = 1 ]; then
    if VIBECAF_NONINTERACTIVE=1 turn_off_locked 0 "$reason" >/dev/null 2>&1; then notify_event "Awake mode turned off" "$reason"; return; fi
  elif VIBECAF_NONINTERACTIVE=1 VIBECAF_SESSION_END_REASON="$reason" turn_off >/dev/null 2>&1; then
    notify_event "Awake mode turned off" "$reason"; return
  fi
  recovery_mark_failed "$id"
  if [ "$(read_field "$SESSION_DIR" last-alert)" != "$reason" ]; then
    write_field "$SESSION_DIR" last-alert "$reason" || true
    notify_event "Safety recovery failed" "$reason; normal sleep is still blocked"
  fi; return 1
}
guardian_recover() {
  local reason=$1 id; id=$(current_session_id)
  if VIBECAF_NONINTERACTIVE=1 VIBECAF_RECOVERY_LOCK=1 VIBECAF_SESSION_END_REASON="$reason" turn_off >/dev/null 2>&1; then notify_event "Awake mode recovered" "$reason"; return; fi
  recovery_mark_failed "$id"
  if [ "$(read_field "$SESSION_DIR" last-alert)" != "guardian:$reason" ]; then
    write_field "$SESSION_DIR" last-alert "guardian:$reason" || true
    notify_event "Crash recovery failed" "$reason; normal sleep is still blocked"
  fi; return 1
}
guardian_reconcile_off() {
  local id state
  lock_acquire || return 1
  if [ "$(sleep_disabled_state)" = 0 ]; then
    state=$(read_field "$SESSION_DIR" state)
    if modern_session_owned; then
      if [ "$state" != enabling ] || ! session_enabler_alive; then
        id=$(current_session_id); session_id=$id
        history_capture_current "sleep was already restored" verified || true
        retire_session_processes "$id" && session_clear
      fi
    elif ownership_residue_unknown || legacy_session_residue; then
      retire_residue_processes && session_clear
    fi
  fi
  lock_release
}
guardian_check_once() {
  local phase state heartbeat now age deadline started id
  phase=$(session_phase)
  case "$phase" in unknown) return 1 ;; off) guardian_reconcile_off; return ;; external-on) return ;; esac
  state=$(read_field "$SESSION_DIR" state)
  now=$(date +%s); deadline=$(read_uint "$SESSION_DIR" deadline 0)
  id=$(current_session_id)
  if [ -n "$id" ]; then
    write_field "$SESSION_DIR" guardian_session "$id" || true
    write_field "$SESSION_DIR" guardian_heartbeat "$now" || true
  fi
  if modern_session_owned && ! session_valid; then guardian_recover "owned session policy is invalid"; return; fi
  if [ "$state" = enabling ]; then
    started=$(read_uint "$SESSION_DIR" started_at 0); age=$((now-started))
    if [ "$deadline" -eq 0 ] || [ "$now" -ge "$deadline" ] || [ "$age" -lt 0 ] || [ "$age" -ge "$ACTIVATION_GRACE" ]; then
      guardian_recover "session activation timed out"
    elif ! session_enabler_alive; then guardian_recover "session activation did not finish"; fi
    return
  fi
  heartbeat=$(read_uint "$SESSION_DIR" heartbeat 0); age=$((now-heartbeat))
  if [ "$heartbeat" -eq 0 ] || [ "$age" -lt 0 ] || [ "$age" -gt "$GUARDIAN_GRACE" ]; then guardian_recover "guard heartbeat lost"; return; fi
  if [ "$deadline" -eq 0 ] || [ "$now" -ge "$deadline" ]; then guardian_recover "session deadline passed"; fi
}
guardian_loop() { while :; do guardian_check_once || true; sleep "$GUARDIAN_EVERY"; done; }

preflight_on() {
  local blob src pct thermal
  [ "$(sleep_disabled_state)" = 0 ] || return 1
  blob=$(batt_blob) || { echo "Cannot read battery and power state." >&2; return 1; }
  src=$(power_source "$blob"); pct=$(battery_num "$blob")
  [ "$src" != unknown ] && valid_battery_percent "$pct" || { echo "Cannot verify battery and power state." >&2; return 1; }
  pct=$(uint_normalize "$pct")
  [ "$REQUIRE_AC" != 1 ] || [ "$src" = AC ] || { echo "AC power is required by the next-session policy." >&2; return 1; }
  [ "$src" != Battery ] || [ "$pct" -gt "$BATTERY_FLOOR" ] || { echo "Battery is at ${pct}%, at or below the ${BATTERY_FLOOR}% safety floor." >&2; return 1; }
  thermal=$(thermal_state)
  case "$thermal" in nominal|fair) ;; serious|critical) echo "Thermal pressure is $thermal; awake mode was not enabled." >&2; return 1 ;;
    *) echo "Thermal monitoring is unavailable; awake mode was not enabled." >&2; return 1 ;; esac
  [ "$(guardian_status)" = running ] || { echo "Crash recovery guardian is not running." >&2; return 1; }
  preflight_restore || { echo "Unattended sleep restoration is not authorized." >&2; return 1; }
}

activation_rollback() {
  local id=$1
  if admin_pmset 0 && [ "$(sleep_disabled_state)" = 0 ]; then
    history_capture_current "activation failed" verified || true
    if retire_session_processes "$id" && session_clear; then return; fi
    echo "Normal sleep was restored, but session processes could not be retired; recovery remains armed." >&2
    return 1
  fi
  history_capture_current "activation failed" failed || true
  recovery_mark_failed "$id"; start_guard || true
  echo "Activation failed and normal sleep could not be restored; recovery remains armed." >&2; return 1
}
turn_on_locked() {
  local duration=$1 phase now id blob start_source start_battery; phase=$(session_phase)
  case "$phase" in owned-on)
      { ! modern_session_owned || session_valid; } || issue_add "Owned session policy is malformed"
      if session_active; then
        start_guard || { echo "Owned session exists, but its safety guard could not start." >&2; return 1; }
        start_observation || true; session_id=$(current_session_id)
        [ "$(read_field "$SESSION_DIR" recovery 1)" = 0 ] || start_network_monitor || true
        echo "AWAKE MODE: ON"; echo "Existing session retained; its deadline was not extended."; return
      fi
      turn_off_locked 0 >/dev/null || return 1 ;;
    external-on) echo "Sleep is blocked by another tool. No lidwise session was created." >&2; return 1 ;;
    unknown) echo "Cannot read SleepDisabled; refusing to change power state." >&2; return 1 ;; esac
  preflight_on || return 1; now=$(date +%s); id="$now.$$.$RANDOM"
  blob=$(batt_blob || true); start_source=$(power_source "$blob"); start_battery=$(battery_num "$blob")
  valid_battery_percent "$start_battery" || start_battery=-
  case "$start_source" in AC|Battery|unknown) ;; *) start_source=- ;; esac
  session_claim "$id" "$now" "$duration" "$start_battery" "$start_source" || { session_clear; echo "Could not create the durable recovery record. Awake mode was not enabled." >&2; return 1; }
  if ! admin_pmset 1 || [ "$(sleep_disabled_state)" != 1 ] || ! session_claim_current "$id"; then
    echo "Awake mode could not be enabled and verified; restoring normal sleep." >&2
    activation_rollback "$id"; return 1
  fi
  if ! start_caffeinate || ! session_activate || ! start_guard; then activation_rollback "$id"; return 1; fi
  start_observation || true
  session_id=$id
  [ "$(read_field "$SESSION_DIR" recovery 1)" = 0 ] || start_network_monitor || true
  blob=$(batt_blob || true); echo "AWAKE MODE: ON"; echo "Session: $id"; echo "Deadline: $((now+duration)) ($duration seconds)"; echo "Power: $(power_source "$blob") $(battery_pct "$blob")"
}
turn_on() {
  local duration=${1:-$(config_duration)} rc
  valid_duration "$duration" || { echo "Duration must be an integer from 1 to 21600 seconds." >&2; return 2; }
  duration=$(uint_normalize "$duration")
  lock_acquire || return 1; turn_on_locked "$duration"; rc=$?; lock_release; return "$rc"
}
turn_off_locked() {
  local force=$1 reason=${2:-manual} phase id; phase=$(session_phase)
  case "$phase" in unknown) echo "Cannot read SleepDisabled; refusing to change power state." >&2; return 1 ;;
    off)
      if session_owned; then
        id=$(current_session_id); session_id=$id
        history_capture_current "$reason" verified || true
        retire_session_processes "$id" && session_clear || {
          echo "Normal sleep is restored, but session processes could not be retired." >&2; return 1;
        }
      elif ownership_residue_unknown || legacy_session_residue; then
        retire_residue_processes && session_clear || {
          echo "Normal sleep is restored, but stale session processes could not be retired." >&2; return 1;
        }
      fi
      echo "AWAKE MODE: OFF"; echo "Normal sleep behaviour is already restored."; return ;;
    external-on) [ "$force" = 1 ] || { echo "Sleep is blocked by another tool. Use 'off --force' to override it." >&2; return 1; }
      admin_pmset 0 && [ "$(sleep_disabled_state)" = 0 ] || { echo "Could not restore and verify normal sleep." >&2; return 1; }
      legacy_session_residue && session_clear || true
      echo "AWAKE MODE: OFF"; echo "External sleep block cleared by explicit override."; return ;; esac
  id=$(current_session_id)
  admin_pmset 0 && [ "$(sleep_disabled_state)" = 0 ] || {
    history_capture_current "$reason" failed || true
    recovery_mark_failed "$id"; echo "Lid-close sleep is still blocked; the safety guard remains active." >&2; return 1;
  }
  session_id=$id
  history_capture_current "$reason" verified || true
  retire_session_processes "$id" && session_clear || {
    echo "Normal sleep was restored, but session processes could not be retired; recovery remains armed." >&2; return 1;
  }
  echo "AWAKE MODE: OFF"; echo "Normal sleep behaviour restored."
}
turn_off() {
  local force=0 rc reason=${VIBECAF_SESSION_END_REASON:-manual}
  [ "${1:-}" = --force ] && force=1
  if [ "${VIBECAF_RECOVERY_LOCK:-0}" = 1 ]; then lock_reclaim_for_recovery || return 1; fi
  lock_acquire || return 1
  turn_off_locked "$force" "$reason"; rc=$?; lock_release; return "$rc"
}
toggle() {
  local phase rc; lock_acquire || return 1; phase=$(session_phase)
  case "$phase" in off) turn_on_locked "$(config_duration)"; rc=$? ;; owned-on) turn_off_locked 0 toggle; rc=$? ;;
    external-on) echo "Sleep is blocked by another tool; toggle made no change." >&2; rc=1 ;;
    unknown) echo "Cannot read SleepDisabled; refusing to change power state." >&2; rc=1 ;; esac
  lock_release; return "$rc"
}

extend_session() {
  local by=$1 rc deadline
  valid_duration "$by" || { echo "Extension must be an integer from 1 to 21600 seconds." >&2; return 2; }
  by=$(uint_normalize "$by")
  lock_acquire || return 1
  if [ "$(session_phase)" != owned-on ]; then rc=1
  else deadline=$(session_extend_deadline "$by"); rc=$?; fi
  lock_release
  case "$rc" in
    0) echo "AWAKE MODE: ON"; echo "Deadline extended to: $deadline" ;;
    1) echo "Only an active, unexpired lidwise session can be extended." >&2 ;;
    2) echo "Extension must be an integer from 1 to 21600 seconds." >&2 ;;
    3) echo "Extension would exceed the six-hour total session limit." >&2 ;;
  esac
  return "$rc"
}

json_escape() {
  printf '%s' "$1" | awk 'BEGIN{ORS=""} {if(NR>1)printf "\\n"; gsub(/\\/,"\\\\"); gsub(/\"/,"\\\""); gsub(/\t/,"\\t"); gsub(/\r/,"\\r"); printf "%s",$0}'
}
json_string_or_null() { [ -n "${1:-}" ] && [ "$1" != unknown ] || { printf null; return; }; printf '"%s"' "$(json_escape "$1")"; }
ISSUES_JSON=""; RECOVERY_READY=false; RECOVERY_AUTH_CURRENT=false; RECOVERY_AUTH_AT=0
issue_add() { local v; v=$(json_escape "$1"); [ -z "$ISSUES_JSON" ] || ISSUES_JSON="$ISSUES_JSON,"; ISSUES_JSON="$ISSUES_JSON\"$v\""; }
recovery_assess() {
  local phase=$1 thermal=$2 guard=$3 guardian=$4 verified verified_session now id heartbeat guardian_heartbeat guardian_session age
  verified=$(read_epoch "$SESSION_DIR" recovery_verified_at 0); verified_session=$(read_field "$SESSION_DIR" recovery_verified_session)
  now=$(date +%s); id=$(current_session_id)
  [ "$verified_session" = "$id" ] || verified=0
  ISSUES_JSON=""; RECOVERY_READY=false; RECOVERY_AUTH_CURRENT=false; RECOVERY_AUTH_AT=$verified
  [ "$thermal" != unknown ] || issue_add "Thermal monitoring is unavailable"
  case "$phase" in owned-on)
      { ! modern_session_owned || session_valid; } || issue_add "Owned session policy is malformed"
      heartbeat=$(read_epoch "$SESSION_DIR" heartbeat 0); age=$((now-heartbeat))
      [ "$guard" = true ] && [ "$heartbeat" -gt 0 ] && [ "$age" -ge 0 ] && [ "$age" -le $((GUARD_EVERY * 3)) ] || issue_add "Safety guard health is stale"
      guardian_heartbeat=$(read_epoch "$SESSION_DIR" guardian_heartbeat 0); guardian_session=$(read_field "$SESSION_DIR" guardian_session)
      age=$((now-guardian_heartbeat))
      [ "$guardian" = running ] && [ "$guardian_session" = "$id" ] && [ "$guardian_heartbeat" -gt 0 ] &&
        [ "$age" -ge 0 ] && [ "$age" -le $((GUARDIAN_EVERY * 3)) ] || issue_add "Crash recovery guardian health is stale"
      [ "$verified" -gt 0 ] || issue_add "Unattended sleep restoration is not verified" ;;
    external-on) issue_add "Sleep is blocked by another tool" ;;
    unknown) if ownership_residue_unknown; then issue_add "Session ownership record is incomplete"
      else issue_add "Power state could not be read"; fi ;; esac
  if [ "$phase" = owned-on ]; then
    if recovery_authorization_current; then RECOVERY_AUTH_CURRENT=true
    else issue_add "Current unattended restoration authorization is unavailable"; fi
  fi
  [ "$phase" = owned-on ] && [ -z "$ISSUES_JSON" ] && RECOVERY_READY=true
}
status_json() {
  local live=$1 phase id="" started="" deadline="" remaining="" now blob source pct thermal guard guardian
  local duration floor require_ac recovery notifications nt nd agents goals can_extend=false last_session
  phase=$(session_phase); now=$(date +%s); duration=$(config_duration); floor=$(config_battery_floor); require_ac=$(config_require_ac)
  recovery=$(config_recovery); notifications=$(config_notifications)
  if [ "$phase" = owned-on ]; then
    id=$(current_session_id)
    if session_valid; then
      started=$(read_uint "$SESSION_DIR" started_at 0); deadline=$(read_uint "$SESSION_DIR" deadline 0)
      duration=$((deadline - started)); floor=$(read_uint "$SESSION_DIR" battery_floor "$floor")
      require_ac=$(read_uint "$SESSION_DIR" require_ac 0)
      recovery=$(read_field "$SESSION_DIR" recovery "$recovery"); notifications=$(read_field "$SESSION_DIR" notifications "$notifications")
    elif legacy_session_valid; then
      started=$(read_uint "$SESSION_DIR" started 0); deadline=$(read_uint "$SESSION_DIR" deadline 0); duration=$((deadline-started))
    else
      started=$(read_epoch "$SESSION_DIR" started_at 0); deadline=$(read_epoch "$SESSION_DIR" deadline 0)
      [ "$started" -gt 0 ] || started=""; [ "$deadline" -gt 0 ] || deadline=""
    fi
    if [ -n "$deadline" ]; then
      remaining=$((deadline-now)); [ "$remaining" -ge 0 ] || remaining=0
      if modern_session_owned && session_valid && [ "$(read_field "$SESSION_DIR" state)" = active ] &&
         [ "$deadline" -gt "$now" ] && [ "$deadline" -lt $((started + 21600)) ]; then can_extend=true; fi
    fi
  fi
  blob=$(batt_blob || true); source=$(power_source "$blob"); pct=$(battery_num "$blob")
  if valid_battery_percent "$pct"; then pct=$(uint_normalize "$pct"); else pct=""; fi
  thermal=$(thermal_state); if guard_pid >/dev/null 2>&1; then guard=true; else guard=false; fi
  guardian=$(guardian_status); recovery_assess "$phase" "$thermal" "$guard" "$guardian"
  if [ "$live" = 1 ]; then nt=$(link_state 2>/dev/null || echo unknown); nd=$(net_words "$nt" 2>/dev/null || echo "Not checked")
  else nt=$(network_status_token 2>/dev/null || echo unknown); nd=$(cheap_net 2>/dev/null || echo "Not checked"); fi
  case "$nt" in online|portal|deadlink|noip|unassoc|radio_off|unknown) ;; *) nt=unknown ;; esac
  [ -n "$nd" ] && [ "$nd" != unknown ] || nd="Not checked"
  agents=$(agents_json 2>/dev/null) || agents='{"claude":{"working":0,"waiting":0,"quiet":0,"finished":0,"failed":0},"codex":{"working":0,"waiting":0,"quiet":0,"finished":0,"failed":0}}'
  goals=$(goals_json 2>/dev/null) || goals='{"active":0,"stalled":0,"completed":0,"failed":0}'
  case "$agents" in \{*\}) ;; *) agents='{"claude":{"working":0,"waiting":0,"quiet":0,"finished":0,"failed":0},"codex":{"working":0,"waiting":0,"quiet":0,"finished":0,"failed":0}}' ;; esac
  case "$goals" in \{*\}) ;; *) goals='{"active":0,"stalled":0,"completed":0,"failed":0}' ;; esac
  printf '{"schema_version":1,"phase":"%s","session_id":' "$phase"; json_string_or_null "$id"; printf ','
  if [ -n "$started" ]; then printf '"started_at":%s,' "$started"; else printf '"started_at":null,'; fi
  if [ -n "$deadline" ]; then printf '"deadline":%s,' "$deadline"; else printf '"deadline":null,'; fi
  if [ -n "$remaining" ]; then printf '"remaining_seconds":%s,' "$remaining"; else printf '"remaining_seconds":null,'; fi
  printf '"duration_seconds":%s,"default_duration_seconds":%s,"battery_floor":%s,"default_battery_floor":%s,"require_ac":%s,"default_require_ac":%s,"can_extend":%s,"power_source":' \
    "$duration" "$(config_duration)" "$floor" "$(config_battery_floor)" \
    "$([ "$require_ac" = 1 ] && echo true || echo false)" "$([ "$(config_require_ac)" = 1 ] && echo true || echo false)" "$can_extend"
  json_string_or_null "$source"; printf ','
  if [ -n "$pct" ]; then printf '"battery_percent":%s,' "$pct"; else printf '"battery_percent":null,'; fi
  printf '"thermal":'; json_string_or_null "$thermal"; printf ','
  printf '"guard_running":%s,"guardian_running":%s,"recovery_ready":%s,"recovery_authorized_at":' \
    "$guard" "$([ "$guardian" = running ] && echo true || echo false)" "$RECOVERY_READY"
  if [ "$RECOVERY_AUTH_AT" -gt 0 ]; then printf '%s,' "$RECOVERY_AUTH_AT"; else printf 'null,'; fi
  printf '"recovery_authorization_current":%s,"issues":[%s],' "$RECOVERY_AUTH_CURRENT" "$ISSUES_JSON"
  printf '"network_state":"%s","network_detail":"%s","network_recovery":%s,"network_recovery_available":%s,"agent_notifications":%s,' \
    "$nt" "$(json_escape "$nd")" "$([ "$recovery" = 1 ] && echo true || echo false)" \
    "$(network_recovery_available && echo true || echo false)" "$([ "$notifications" = 1 ] && echo true || echo false)"
  last_session=$(history_last_json)
  printf '"agents":%s,"goals":%s,"last_session":%s,"observed_at":%s}\n' "$agents" "$goals" "$last_session" "$now"
}
status_human() {
  local live=$1 phase label id deadline now remaining blob network
  phase=$(session_phase); case "$phase" in off) label=OFF ;; owned-on) label=ON ;; external-on) label=EXTERNAL ;; unknown) label=UNKNOWN ;; esac
  echo "AWAKE MODE: $label"; echo "Phase: $phase"
  if [ "$phase" = owned-on ]; then id=$(current_session_id); deadline=$(read_uint "$SESSION_DIR" deadline 0); now=$(date +%s)
    remaining=$((deadline-now)); [ "$remaining" -ge 0 ] || remaining=0
    echo "Session: $id"; echo "Auto-off in: $((remaining/3600))h $(((remaining%3600)/60))m"; echo "Battery floor: $(read_uint "$SESSION_DIR" battery_floor "$BATTERY_FLOOR")%"
    echo "Requires AC: $([ "$(read_uint "$SESSION_DIR" require_ac 0)" = 1 ] && echo yes || echo no)"
  else echo "Auto-off in: n/a"; echo "Battery floor: $(config_battery_floor)%"; echo "Requires AC: $([ "$(config_require_ac)" = 1 ] && echo yes || echo no)"; fi
  echo "Guard pid: $(guard_pid 2>/dev/null || echo none)"; echo "Crash guardian: $(guardian_status)"; echo "Thermal: $(thermal_state)"
  if type goals_summary >/dev/null 2>&1; then refresh_goals >/dev/null 2>&1 || true; echo "Goals: $(goals_summary)"; fi
  if type agents_summary >/dev/null 2>&1; then refresh_agents >/dev/null 2>&1 || true; agents_summary; fi
  if [ "$live" = 1 ]; then network=$(net_words "$(link_state)"); else network=$(cheap_net 2>/dev/null || echo unknown); fi
  echo "Network: $network"; blob=$(batt_blob || true); echo "Power: $(power_source "$blob") $(battery_pct "$blob")"
}
status_command() {
  local json=0 net=0; shift
  while [ "$#" -gt 0 ]; do case "$1" in --json) json=1 ;; --net) net=1 ;; *) echo "usage: lidwise status [--json] [--net]" >&2; return 2 ;; esac; shift; done
  if [ "$json" = 1 ]; then status_json "$net"; else status_human "$net"; fi
}

config_get() {
  [ "${1:-}" = --json ] || { echo "usage: lidwise config get --json" >&2; return 2; }
  printf '{"schema_version":1,"duration_seconds":%s,"battery_floor":%s,"require_ac":%s,"network_recovery":%s,"agent_notifications":%s}\n' \
    "$(config_duration)" "$(config_battery_floor)" "$([ "$(config_require_ac)" = 1 ] && echo true || echo false)" \
    "$([ "$(config_recovery)" = 1 ] && echo true || echo false)" "$([ "$(config_notifications)" = 1 ] && echo true || echo false)"
}
config_set_locked() {
  local key=$1 value=$2 phase; state_init || return 1
  case "$key" in duration) valid_duration "$value" || { echo "Duration must be an integer from 1 to 21600 seconds." >&2; return 2; }
      value=$(uint_normalize "$value"); write_field "$CONFIG_DIR" duration "$value" || return 1 ;;
    battery-floor) valid_percent "$value" || { echo "Battery floor must be an integer from 1 to 100 percent." >&2; return 2; }
      value=$(uint_normalize "$value"); write_field "$CONFIG_DIR" battery-floor "$value" || return 1; BATTERY_FLOOR=$value ;;
    require-ac) case "$value" in on) value=1 ;; off) value=0 ;; *) echo "Require AC must be on or off." >&2; return 2 ;; esac
      write_field "$CONFIG_DIR" require-ac "$value" || return 1; REQUIRE_AC=$value ;;
    recovery) case "$value" in on) value=1 ;; off) value=0 ;; *) echo "Recovery must be on or off." >&2; return 2 ;; esac
      write_field "$CONFIG_DIR" recovery "$value" || return 1; NETWORK_RECOVERY=$([ "$value" = 1 ] && echo on || echo off); phase=$(session_phase)
      if [ "$phase" = owned-on ]; then write_field "$SESSION_DIR" recovery "$value" || return 1
        session_id=$(current_session_id)
        if [ "$value" = 1 ]; then start_network_monitor || true; else stop_network_monitor || true; fi; fi ;;
    notifications) case "$value" in on) value=1 ;; off) value=0 ;; *) echo "Notifications must be on or off." >&2; return 2 ;; esac
      write_field "$CONFIG_DIR" notifications "$value" || return 1; AGENT_NOTIFY=$value
      [ "$(session_phase)" != owned-on ] || write_field "$SESSION_DIR" notifications "$value" || return 1 ;;
    *) echo "Unknown config key: $key" >&2; return 2 ;; esac
  echo "Configuration updated."
}
config_command() {
  local action=${1:-} rc; shift || true
  case "$action" in get) config_get "$@" ;; set) [ "$#" -eq 2 ] || { echo "usage: lidwise config set duration SECONDS|battery-floor PERCENT|require-ac on|off|recovery on|off|notifications on|off" >&2; return 2; }
      lock_acquire || return 1; config_set_locked "$1" "$2"; rc=$?; lock_release; return "$rc" ;;
    *) echo "usage: lidwise config get --json | config set ..." >&2; return 2 ;; esac
}
doctor() {
  local phase blob thermal guardian runtime=missing state=missing
  if [ -e "$RUNTIME_DIR" ]; then runtime=unsafe; runtime_is_secure && runtime=ok; fi
  if [ -e "$STATE_DIR" ]; then state=unsafe; private_dir_valid "$STATE_DIR" && state=ok; fi
  phase=$(session_phase); blob=$(batt_blob || true); thermal=$(thermal_state); guardian=$(guardian_status)
  echo "Lidwise diagnostics"; echo "power phase: $phase"; echo "power source: $(power_source "$blob")"
  echo "battery percent: $(battery_pct "$blob" | tr -d '%' || true)"; echo "thermal: $thermal"
  echo "runtime directory: $runtime ($RUNTIME_DIR)"; echo "state directory: $state ($STATE_DIR)"; echo "crash guardian: $guardian"
  echo "safety guard: $(guard_pid >/dev/null 2>&1 && echo running || echo stopped)"
  echo "current restoration authorization: $(recovery_authorization_current && echo available || echo unavailable)"
  echo "network monitoring setting: $NETWORK_RECOVERY"; echo "automatic network recovery: unavailable"
  echo "agent notifications setting: $([ "$(config_notifications)" = 1 ] && echo on || echo off)"
  echo "thermal helper: $THERMAL_STATE_CMD"; echo "pmset: $PMSET"
}

dhcp_renew_available() { [ -n "$(wifi_service "$1")" ]; }
netdiag() {
  local dev st ip gw radio; dev=$(wifi_device); st=$(link_state "$dev"); ip=$("$IPCONFIG" getifaddr "$dev" 2>/dev/null || true)
  gw=$("$ROUTE" -n get default 2>/dev/null | awk '/gateway:/{print $2;exit}'); radio=$("$NETWORKSETUP" -getairportpower "$dev" 2>/dev/null | awk '{print $NF}')
  echo "device:      ${dev:-none}"; echo "radio:       ${radio:-unknown}"; echo "address:     ${ip:-none}"; echo "gateway:     ${gw:-none}"
  echo "state:       $st — $(net_words "$st")"; echo "probe:       $PROBE_URL"
}
maintenance() {
  local rc remove=0 phase
  if [ "${1:-}" = --remove ]; then remove=1; shift; fi
  [ "${1:-}" = -- ] && [ "$#" -ge 2 ] || { echo "usage: lidwise __maintenance [--remove] -- COMMAND [ARGS...]" >&2; return 2; }; shift
  lock_acquire || return 1
  phase=$(session_phase)
  if [ "$remove" = 1 ] && [ "$phase" = owned-on ]; then turn_off_locked 0 >/dev/null || { lock_release; return 1; }; phase=$(session_phase); fi
  case "$phase" in off) ;; external-on) [ "$remove" = 1 ] || { echo "Maintenance requires verified normal sleep." >&2; lock_release; return 1; } ;;
    *) echo "Maintenance requires a known safe ownership state." >&2; lock_release; return 1 ;; esac
  "$@"; rc=$?; lock_release; return "$rc"
}
usage() { echo "usage: lidwise [on [--for SECONDS]|extend --by SECONDS|off [--force]|toggle|status [--json] [--net]|history [--json]|config get --json|config set ...|hooks ...|verify ...|doctor|netlog|netdiag|agents|goals|goal ...]" >&2; }

command=${1:-toggle}
case "$command" in on) shift; duration=$(config_duration); if [ "$#" -gt 0 ]; then [ "$#" -eq 2 ] && [ "$1" = --for ] || { usage; exit 2; }; duration=$2; fi; turn_on "$duration" ;;
  extend) [ "$#" -eq 3 ] && [ "$2" = --by ] || { usage; exit 2; }; extend_session "$3" ;;
  off) shift; [ "$#" -le 1 ] || { usage; exit 2; }; [ "$#" -eq 0 ] || [ "$1" = --force ] || { usage; exit 2; }; turn_off "${1:-}" ;;
  toggle) [ "$#" -eq 1 ] || { usage; exit 2; }; toggle ;; status) status_command "$@" ;; history) shift; history_command "$@" ;; config) shift; config_command "$@" ;;
  hooks) shift; exec "$AGENT_SCAN_CMD" --hooks "$@" ;;
  verify) shift; exec "$LID_PROBE_CMD" "$@" ;;
  doctor) [ "$#" -eq 1 ] || { usage; exit 2; }; doctor ;;
  netlog) if [ "${2:-}" = --path ] && [ "$#" -eq 2 ]; then printf '%s\n' "$NETLOG"
    elif [ "$#" -eq 1 ]; then [ -f "$NETLOG" ] && tail -40 "$NETLOG" || echo "no watchdog log yet"
    else usage; exit 2; fi ;;
  netdiag) netdiag ;; goals) goals_list "${2:-}" ;; agents) agents_list "${2:-}" ;; goal) shift; goal_command "$@" ;;
  __netwatch) netwatch_loop ;; __guard) guard_loop ;; __guard_once) guard_check_once ;; __guardian) guardian_loop ;; __guardian_once) guardian_check_once ;;
  __network_transition) notify_network_transition "${2:-}" "${3:-}" ;; __dhcp_renew) dhcp_renew "${2:-$(wifi_device)}" ;;
  __observation) observation_loop ;; __observation_once) goals_refresh; agents_cache_current 45 || agents_refresh ;;
  __observation_scan) goals_refresh; agents_refresh ;;
  __maintenance) shift; maintenance "$@" ;; *) usage; exit 2 ;; esac
